{
  "name": "@trustpin/react-native-attest",
  "version": "7.1.1",
  "description": "TrustPin app attestation for React Native — proves to your API that requests come from your genuine app on a genuine device, checked by your own TrustPin verifier",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "TrustPinReactNativeAttest.podspec",
    "LICENSE",
    "README.md",
    "app.plugin.js",
    "plugin/build",
    "!**/__tests__",
    "!android/build",
    "!android/.gradle",
    "!android/local.properties",
    "!ios/build",
    "!android/src/test",
    "!plugin/build/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p plugin/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p plugin/tsconfig.json --noEmit",
    "test": "jest",
    "prepack": "npm run build"
  },
  "keywords": [
    "react-native",
    "app-attestation",
    "app-attest",
    "play-integrity",
    "security",
    "trustpin"
  ],
  "author": "TrustPin (https://trustpin.cloud)",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/trustpin-cloud/react-native.sdk/tree/main/attest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trustpin-cloud/react-native.sdk.git",
    "directory": "attest"
  },
  "bugs": {
    "url": "https://github.com/trustpin-cloud/react-native.sdk/issues"
  },
  "peerDependencies": {
    "@trustpin/react-native": "~7.1.0",
    "expo": "*",
    "react": "*",
    "react-native": ">=0.85.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "TrustPinReactNativeAttestSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "cloud.trustpin.reactnative.attest"
    }
  }
}

{
  "name": "@trustpin/react-native",
  "version": "6.2.0",
  "description": "TrustPin SSL/TLS certificate pinning for React Native — in-handshake enforcement via the native TrustPin SDKs",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "TrustPinReactNative.podspec",
    "LICENSE",
    "README.md",
    "app.plugin.js",
    "plugin/build",
    "!**/__tests__",
    "!android/build",
    "!android/.gradle",
    "!android/local.properties",
    "!ios/build",
    "!android/src/test",
    "!plugin/build/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p plugin/tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p plugin/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "prepack": "npm run build",
    "build:plugin": "tsc -p plugin/tsconfig.json",
    "docs": "typedoc"
  },
  "keywords": [
    "react-native",
    "ssl-pinning",
    "certificate-pinning",
    "tls",
    "security",
    "trustpin"
  ],
  "author": "TrustPin (https://trustpin.cloud)",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/trustpin-cloud/react-native.sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trustpin-cloud/react-native.sdk.git"
  },
  "bugs": {
    "url": "https://github.com/trustpin-cloud/react-native.sdk/issues"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": ">=0.85.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "~57.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "ts-jest": "^29.2.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  },
  "codegenConfig": {
    "name": "TrustPinReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "cloud.trustpin.reactnative"
    },
    "ios": {
      "modulesConformingToProtocol": {
        "RCTURLRequestHandler": [
          "TrustPinURLRequestHandler"
        ]
      }
    }
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  }
}

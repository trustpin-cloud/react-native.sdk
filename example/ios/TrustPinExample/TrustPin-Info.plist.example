<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for the iOS TrustPin credentials.

  Copy this file to TrustPin-Info.plist in the same directory, fill in the
  values from https://app.trustpin.cloud, and add it to the Xcode target's
  "Copy Bundle Resources" phase. The real file is gitignored: none of these
  values are secret, but they identify a specific project and do not belong in
  a public repository.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>OrganizationId</key>
	<string>YOUR_ORGANIZATION_ID</string>
	<key>ProjectId</key>
	<string>YOUR_PROJECT_ID</string>
	<key>PublicKey</key>
	<string>YOUR_BASE64_EC_PUBLIC_KEY</string>
	<!-- Optional. "strict" (default, production) or "permissive". -->
	<key>Mode</key>
	<string>strict</string>
</dict>
</plist>
